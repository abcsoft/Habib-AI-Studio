# Habib AI Studio — copy to .env or run node scripts/setup-dev.mjs.
# No secrets belong in Git. Empty optional values are treated as unset.

# PostgreSQL 16+; docker-compose.yml supplies this development database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_saas_starter
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Production: https://mdhabiburrahman.xyz (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# Claude = reasoning, strategy, audience, brand voice, copy, briefs, prompts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Image model = independent image rendering through Vercel AI Gateway.
AI_GATEWAY_API_KEY=
AI_IMAGE_MODEL=openai/gpt-image-1
# Development ONLY. Simulated calls still exercise the authenticated ledger.
# The public /demo always simulates locally, independently of this setting.
# MUST be false in production. Production startup refuses true.
AI_MOCK=true

# Stripe: required in production. Use test keys locally, live keys at launch.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs (price_...), never Product IDs (prod_...). USD.
# Creator: $9/month, 200 credits. Studio: $29/month, 1,000 credits.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_ULTRA_MONTHLY=
# $5 one-time purchase, 100 credits.
STRIPE_PRICE_TOPUP_100=

# Production account verification/reset emails. Verify your sender domain.
RESEND_API_KEY=
EMAIL_FROM="Habib AI Studio <onboarding@resend.dev>"
# Provision and verify this support mailbox before launch.
CONTACT_EMAIL=hello@mdhabiburrahman.xyz

# Production storage. Images are public by URL; see Privacy Policy.
# Without Blob, development uses .generated and owner-checked /api/images.
BLOB_READ_WRITE_TOKEN=
# Production distributed rate limits. Set both or neither in development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random 32+ character secret for protected hourly refund reconciliation.
CRON_SECRET=

# Optional OAuth. Set both values in each pair or leave both empty.
# Callback: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
